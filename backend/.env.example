# Postgres (async URL used by the app, sync URL used by Alembic)
# Port 5434, not 5432 - see docker-compose.yml (this machine already runs a
# native Postgres on 5432).
DATABASE_URL=postgresql+asyncpg://gametaste:gametaste@localhost:5434/gametaste
DATABASE_URL_SYNC=postgresql+psycopg2://gametaste:gametaste@localhost:5434/gametaste

# Hosted Postgres (Neon) - mirrors the enriched games catalog ahead of
# deploy, see README "Hosted database". Not used by default; get real
# values via `neon env pull` (repo root) + the URL transform documented
# in README, then export over DATABASE_URL/DATABASE_URL_SYNC (or set
# these two and point the app at them) to run against Neon instead of
# local Postgres.
NEON_DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?ssl=require
NEON_DATABASE_URL_SYNC=postgresql+psycopg2://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

REDIS_URL=redis://localhost:6379/0

# IGDB (via Twitch OAuth) - https://api-docs.igdb.com/#account-creation
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Anthropic - https://console.anthropic.com
ANTHROPIC_API_KEY=

# Steam Web API - register your own key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Phase 5 - from your Clerk dashboard (clerk.com), API Keys page.
# In production, CLERK_AUTHORIZED_PARTIES must be the real deployed
# frontend origin(s), not localhost - see README "Before deploying".
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Production frontend origin(s), comma-separated - see README "Before
# deploying". Empty/unset in dev; the localhost regex in main.py already
# covers that. Without this set in production, every request from the
# deployed frontend fails CORS.
CORS_ALLOWED_ORIGINS=
